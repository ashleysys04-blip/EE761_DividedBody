# ============================================================
# 3D width-direction split: z<W/2 body = 3e17, z>W/2 body = 7e17
# SHARED: one continuous floating body across the width
# S/D and gate are common to both halves (parallel devices).
# Coarser fine-step (10 mV) and no hcte because 3D is slow / unstable.
# CPU = 4
# ============================================================

go atlas simflags="-P 4"

set Lg = 0.3
set Lsd = 0.5
set tox = 0.02
set tbox = 0.2
set tgate = 0.1
set te = 1e-7
set tp = 1e-7
set LT = 300
set Xsplit = $Lsd+$Lg*0.50
set tsi = 0.05
set W = 0.2
set Zs = $W/2
set Wwall = 0.02

#### mesh define ####
mesh three.d

x.mesh loc=0.00 spac=0.1
x.mesh loc=$Lsd spac=0.01
x.mesh loc=$Xsplit spac=0.02
x.mesh loc=$Lsd+$Lg spac=0.005
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.1

y.mesh loc=-$tox-$tgate spac=0.05
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.005
y.mesh loc=$tsi/2 spac=0.012
y.mesh loc=$tsi spac=0.005
y.mesh loc=$tsi+$tbox spac=0.1

z.mesh loc=0.00 spac=0.03
z.mesh loc=$Zs-$Wwall/2 spac=0.005
z.mesh loc=$Zs+$Wwall/2 spac=0.005
z.mesh loc=$W spac=0.03

#### regions ####
region num=1 x.min=$Lsd x.max=$Lsd+$Lg y.max=-$tox poly
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$tsi silicon
region num=4 x.min=0 x.max=$Lsd y.min=0 y.max=$tsi silicon
region num=5 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.min=0 y.max=$tsi silicon
region num=6 y.min=$tsi y.max=$tsi+$tbox oxide
region num=7 x.min=0 x.max=$Lsd y.max=0 material=vacuum
region num=8 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.max=0 material=vacuum

#### electrodes ####
electrode name=gate x.min=$Lsd x.max=$Lsd+$Lg y.min=-$tox y.max=-$tox
electrode name=source x.max=$Lsd y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg y.min=0 y.max=0
electrode substrate

#### doping ####
doping uniform conc=3.0e17 p.type x.min=$Lsd x.max=$Lsd+$Lg y.min=0 y.max=$tsi z.min=0 z.max=$Zs
doping uniform conc=7.0e17 p.type x.min=$Lsd x.max=$Lsd+$Lg y.min=0 y.max=$tsi z.min=$Zs z.max=$W
doping uniform conc=1e20 n.type reg=4
doping uniform conc=1e20 n.type reg=5
doping uniform conc=1e21 n.type reg=1

save outf=WS3D_A3_B7_SHARED_INIT.str

#### contacts ####
contact name=drain
contact name=source
contact name=substrate

#### probes : body potential in each half (near source side, lower body) ####
probe name=VB_A potential x=0.575 y=0.035 z=0.05
probe name=VB_B potential x=0.575 y=0.035 z=0.15
probe name=PH_A P.CONC    x=0.575 y=0.035 z=0.05
probe name=PH_B P.CONC    x=0.575 y=0.035 z=0.15

#### physical models ####
# NOTE: hcte removed for 3D (temperature diverged in test run)
material material=silicon taun0=$te taup0=$tp

models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel

output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps

#### numerical method ####
method block newton climit=100 itlimit=200 NBLOCKIT=200 trap maxtraps=10

#### gate bias ####
solve vfinal=-0.2 vstep=-0.05 name=gate
save outf=WS3D_A3_B7_SHARED_HRS.str

#### log ####
log outf=WS3D_A3_B7_SHARED.log j.electron j.hole

# ---------------- FORWARD : 0 -> 7 V ----------------
solve vdrain=0 vfinal=2.5 vstep=0.05 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_FWD_2p5.str
solve vfinal=4.0 vstep=0.01 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_FWD_4p0.str
solve vfinal=6.0 vstep=0.01 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_FWD_6p0.str
solve vfinal=7.0 vstep=0.02 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_FWD_7p0.str

# ---------------- REVERSE : 7 -> 0 V ----------------
solve vfinal=6.0 vstep=-0.02 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_REV_6p0.str
solve vfinal=4.0 vstep=-0.01 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_REV_4p0.str
solve vfinal=2.5 vstep=-0.01 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_REV_2p5.str
solve vfinal=0.0 vstep=-0.05 name=drain cname=drain compl=1e-2
save outf=WS3D_A3_B7_SHARED_END.str

log off
quit
