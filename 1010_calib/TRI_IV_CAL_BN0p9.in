# TRI_IV_CAL_BN0p9 : triristor calibration deck. Params: W=600.0, VG=0.4, NBG=1000000000000000.0, DSUB=5.0, TAU=1e-07, AUG=0, AN=1.0, BN=0.9, VMAX=13.0, RATE=0.7, IDVG=0, DPHI=0.001, RC=65.0, CIRC_R=1
# Generated by 1010_calib/make_tri.py. Target device: Noh et al., IEEE EDL 46(8) 1269-1272, 2025.
go atlas simflags="-P 1"
set Lg = 3.0
set Lsd = 1.0
set tox = 0.02
set tgate = 0.25
set Dsub = 5.0
mesh space.mult = 1.0 width = 600
x.mesh loc=0.00 spac=0.25
x.mesh loc=$Lsd-0.25 spac=0.05
x.mesh loc=$Lsd spac=0.01
x.mesh loc=$Lsd+0.3 spac=0.05
x.mesh loc=$Lsd+$Lg/2 spac=0.25
x.mesh loc=$Lsd+$Lg-0.4 spac=0.04
x.mesh loc=$Lsd+$Lg-0.1 spac=0.008
x.mesh loc=$Lsd+$Lg spac=0.005
x.mesh loc=$Lsd+$Lg+0.15 spac=0.02
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.25
y.mesh loc=-$tox-$tgate spac=0.1
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.002
y.mesh loc=0.03 spac=0.008
y.mesh loc=0.2 spac=0.02
y.mesh loc=0.45 spac=0.05
y.mesh loc=1.0 spac=0.2
y.mesh loc=$Dsub spac=0.8
region num=1 x.min=$Lsd x.max=$Lsd+$Lg y.max=-$tox poly
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$Dsub silicon
region num=4 x.max=$Lsd y.max=0 material=vacuum
region num=5 x.min=$Lsd+$Lg y.max=0 material=vacuum
electrode name=gate x.min=$Lsd x.max=$Lsd+$Lg y.min=-$tox-$tgate y.max=-$tox
electrode name=source x.max=$Lsd-0.1 y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg+0.1 y.min=0 y.max=0
doping uniform conc=1e+15 p.type reg=3
doping gaussian conc=5e16 p.type peak=0.10 char=0.19 reg=3
doping gaussian conc=7e20 n.type peak=0 char=0.055 x.right=$Lsd lat.char=0.04 reg=3
doping gaussian conc=7e20 n.type peak=0 char=0.055 x.left=$Lsd+$Lg lat.char=0.04 reg=3
doping uniform conc=1e21 n.type reg=1
save outf=TRI_IV_CAL_BN0p9_INIT.str
contact name=gate workfun=4.171
probe name=VB_well potential x=$Lsd+$Lg/2 y=0.12
probe name=VB_deep potential x=$Lsd+$Lg/2 y=1.0
probe name=PH_well P.CONC x=$Lsd+$Lg/2 y=0.12
material material=silicon taun0=1e-07 taup0=1e-07
models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=300
impact selb length.rel an1=7.03e+05 an2=7.03e+05 bn1=1.108e+06 bn2=1.108e+06 ap1=6.71e+05 ap2=1.582e+06 bp1=1.524e+06 bp2=1.832e+06
output band.param con.band val.band recomb u.srh u.bbt impact e.field
method newton climit=100 itlimit=200 trap maxtraps=10
solve init
solve prev
solve vgate=0 vstep=0.05 vfinal=0.4 name=gate
save outf=TRI_IV_CAL_BN0p9_VG.str master

go atlas simflags="-P 1"
.begin
Vdrain 4 0 pwl 0, 0, 1.857143e-02, 13.0, 3.714286e-02, 0
Rd 4 1 65
Rs 5 0 65
Vgate  2 0 0.4
Adev 1=drain 5=source 2=gate width=600 infile=TRI_IV_CAL_BN0p9_VG.str
.nodeset v(1)=0 v(4)=0 v(5)=0 v(2)=0.4
.numeric lte=0.3 toltr=1e-5
.options print relpot
.log outfile=TRI_IV_CAL_BN0p9.log
.tran 1e-9 3.714286e-02
.save master=TRI_IV_CAL_BN0p9_T tsave=2.857143e-03 5.714286e-03 8.571429e-03 1.000000e-02 1.142857e-02 1.285714e-02 1.428571e-02 1.571429e-02 1.714286e-02 1.857143e-02 2.000000e-02 2.142857e-02 2.285714e-02 2.428571e-02 2.571429e-02 2.714286e-02 2.857143e-02 3.142857e-02 3.428571e-02 3.714286e-02
.end

contact name=gate workfun=4.171
material material=silicon taun0=1e-07 taup0=1e-07
models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=300
impact selb length.rel an1=7.03e+05 an2=7.03e+05 bn1=1.108e+06 bn2=1.108e+06 ap1=6.71e+05 ap2=1.582e+06 bp1=1.524e+06 bp2=1.832e+06
output band.param con.band val.band recomb u.srh u.bbt impact e.field
method newton climit=100 itlimit=200 trap maxtraps=10

go atlas simflags="-P 1"
quit
