# TRI_DEF_VG0p30 : triristor calibration deck. Params: VG=0.3, NBG=1000000000000000.0, DSUB=5.0, TAU=1e-07, AUG=0, AN=1.0, BN=1.0, VMAX=13.0, RATE=0.7, IDVG=0
# Generated by 1010_calib/make_tri.py. Target device: Noh et al., IEEE EDL 46(8) 1269-1272, 2025.
go atlas simflags="-P 1"
set Lg = 3.0
set Lsd = 1.0
set tox = 0.02
set tgate = 0.25
set Dsub = 5.0
mesh space.mult = 1.0 width = 600
x.mesh loc=0.00 spac=0.25
x.mesh loc=$Lsd-0.25 spac=0.05
x.mesh loc=$Lsd spac=0.01
x.mesh loc=$Lsd+0.3 spac=0.05
x.mesh loc=$Lsd+$Lg/2 spac=0.25
x.mesh loc=$Lsd+$Lg-0.4 spac=0.04
x.mesh loc=$Lsd+$Lg-0.1 spac=0.008
x.mesh loc=$Lsd+$Lg spac=0.005
x.mesh loc=$Lsd+$Lg+0.15 spac=0.02
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.25
y.mesh loc=-$tox-$tgate spac=0.1
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.002
y.mesh loc=0.03 spac=0.008
y.mesh loc=0.2 spac=0.02
y.mesh loc=0.45 spac=0.05
y.mesh loc=1.0 spac=0.2
y.mesh loc=$Dsub spac=0.8
region num=1 x.min=$Lsd x.max=$Lsd+$Lg y.max=-$tox poly
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$Dsub silicon
region num=4 x.max=$Lsd y.max=0 material=vacuum
region num=5 x.min=$Lsd+$Lg y.max=0 material=vacuum
electrode name=gate x.min=$Lsd x.max=$Lsd+$Lg y.min=-$tox-$tgate y.max=-$tox-$tgate
electrode name=source x.max=$Lsd-0.1 y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg+0.1 y.min=0 y.max=0
doping uniform conc=1e+15 p.type reg=3
doping gaussian conc=5e16 p.type peak=0.10 char=0.19 reg=3
doping gaussian conc=7e20 n.type peak=0 char=0.055 x.right=$Lsd lat.char=0.04 reg=3
doping gaussian conc=7e20 n.type peak=0 char=0.055 x.left=$Lsd+$Lg lat.char=0.04 reg=3
doping uniform conc=1e21 n.type reg=1
save outf=TRI_DEF_VG0p30_INIT.str
contact name=gate n.poly
probe name=VB_well potential x=$Lsd+$Lg/2 y=0.12
probe name=VB_deep potential x=$Lsd+$Lg/2 y=1.0
probe name=PH_well P.CONC x=$Lsd+$Lg/2 y=0.12
material material=silicon taun0=1e-07 taup0=1e-07
models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=300
impact selb length.rel
output band.param con.band val.band recomb u.srh u.bbt impact e.field
method newton climit=100 itlimit=200 trap maxtraps=10
solve init
solve prev
solve vgate=0 vstep=0.05 vfinal=0.3 name=gate
save outf=TRI_DEF_VG0p30_VG.str master
log outf=TRI_DEF_VG0p30.log j.electron j.hole
solve vdrain=2 ramptime=2.857143e-03 tstop=2.857143e-03 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_2.str
solve vdrain=4 ramptime=2.857143e-03 tstop=5.714286e-03 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_4.str
solve vdrain=6 ramptime=2.857143e-03 tstop=8.571429e-03 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_6.str
solve vdrain=7 ramptime=1.428571e-03 tstop=1.000000e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_7.str
solve vdrain=8 ramptime=1.428571e-03 tstop=1.142857e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_8.str
solve vdrain=9 ramptime=1.428571e-03 tstop=1.285714e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_9.str
solve vdrain=10 ramptime=1.428571e-03 tstop=1.428571e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_10.str
solve vdrain=11 ramptime=1.428571e-03 tstop=1.571429e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_11.str
solve vdrain=12 ramptime=1.428571e-03 tstop=1.714286e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_12.str
solve vdrain=13.0 ramptime=1.428571e-03 tstop=1.857143e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_UP_13p0.str
solve vdrain=12 ramptime=1.428571e-03 tstop=2.000000e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_12.str
solve vdrain=11 ramptime=1.428571e-03 tstop=2.142857e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_11.str
solve vdrain=10 ramptime=1.428571e-03 tstop=2.285714e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_10.str
solve vdrain=9 ramptime=1.428571e-03 tstop=2.428571e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_9.str
solve vdrain=8 ramptime=1.428571e-03 tstop=2.571429e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_8.str
solve vdrain=7 ramptime=1.428571e-03 tstop=2.714286e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_7.str
solve vdrain=6 ramptime=1.428571e-03 tstop=2.857143e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_6.str
solve vdrain=4 ramptime=2.857143e-03 tstop=3.142857e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_4.str
solve vdrain=2 ramptime=2.857143e-03 tstop=3.428571e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_2.str
solve vdrain=0 ramptime=2.857143e-03 tstop=3.714286e-02 tstep=1e-9
save outf=TRI_DEF_VG0p30_DN_0.str
log off
quit
