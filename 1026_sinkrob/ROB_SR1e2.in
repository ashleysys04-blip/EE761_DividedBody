# ROB_SR1e2 : Step 15 sink robustness, generated by 1026_sinkrob/make_robust.py from 1007_ddsplit/DDS_TE8_XS60.in
# WISL=0.03, SHL=0.01, SHR=0.01, RES=0.0, SR=100.0, CTAP=0.0, GAP=0.0  (core width 10 nm)
# Island: n+ 1e20, normal Si lifetime (NOT killed). Metal core = tap electrode inside the island; no BOX neck.
# Gate: one continuous gate over both bodies and the island.

go atlas simflags="-P 1"

set Lg = 0.3
set Lsd = 0.5
set tox = 0.02
set tbox = 0.2
set tgate = 0.1
set te = 1e-8
set tp = 1e-8
set LT = 300
set Xsplit = $Lsd+$Lg*0.60
set W = 0.5
set tsi = 0.05
set Wisl = 0.03
set XiL = $Xsplit-$Wisl/2
set XiR = $Xsplit+$Wisl/2
set Ybot = $tsi+$tbox

mesh space.mult = 1.0 width = $W

x.mesh loc=0.00 spac=0.1
x.mesh loc=$Lsd spac=0.005
set XcL = $XiL+0.01
set XcR = $XiR-0.01
x.mesh loc=$XiL spac=0.003
x.mesh loc=$XcL spac=0.001
x.mesh loc=$XcR spac=0.001
x.mesh loc=$XiR spac=0.003
x.mesh loc=0.760 spac=0.003
x.mesh loc=0.785 spac=0.001
x.mesh loc=$Lsd+$Lg spac=0.001
x.mesh loc=0.815 spac=0.003
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.1

y.mesh loc=-$tox-$tgate spac=0.05
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.002
y.mesh loc=$tsi/2 spac=0.01
y.mesh loc=$tsi spac=0.005
y.mesh loc=$tsi+0.05 spac=0.02
y.mesh loc=$Ybot-0.03 spac=0.01
y.mesh loc=$Ybot spac=0.005

region num=1 x.min=$Lsd x.max=$Lsd+$Lg y.max=-$tox poly
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$tsi silicon
region num=4 x.min=0 x.max=$Lsd y.min=0 y.max=$tsi silicon
region num=5 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.min=0 y.max=$tsi silicon
region num=6 y.min=$tsi y.max=$tsi+$tbox oxide
region num=7 x.min=0 x.max=$Lsd y.max=0 material=vacuum
region num=8 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.max=0 material=vacuum
region num=9 x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi silicon

electrode name=gate x.min=$Lsd x.max=$Lsd+$Lg y.min=-$tox y.max=-$tox
electrode name=source x.max=$Lsd y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg y.min=0 y.max=0
set XcL = $XiL+0.01
set XcR = $XiR-0.01
electrode name=tap x.min=$XcL x.max=$XcR y.min=0 y.max=$tsi-0.0
electrode name=substrate x.max=$XiL-0.03 y.min=$Ybot y.max=$Ybot
electrode name=substrate x.min=$XiR+0.03 y.min=$Ybot y.max=$Ybot

doping uniform conc=6.0e17 p.type x.min=$Lsd x.max=$XiL y.min=0 y.max=$tsi
doping uniform conc=7.0e17 p.type x.min=$XiR x.max=$Lsd+$Lg y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type reg=4
doping uniform conc=1e20 n.type reg=5
doping uniform conc=1e21 n.type reg=1

save outf=ROB_SR1e2_INIT.str

contact name=drain
contact name=source
contact name=substrate
contact name=tap workfun=4.17 surf.rec vsurfn=100 vsurfp=100

probe name=VB_left  potential x=($Lsd+$XiL)/2 y=0.035
probe name=VB_right potential x=($XiR+$Lsd+$Lg)/2 y=0.035
probe name=V_shellL potential x=$XiL+0.002 y=0.025
probe name=PH_left  P.CONC x=($Lsd+$XiL)/2 y=0.035
probe name=PH_right P.CONC x=($XiR+$Lsd+$Lg)/2 y=0.035
probe name=QH_left  integrated LEFT=$Lsd RIGHT=$XiL BOTTOM=0 TOP=$tsi P.CONC
probe name=QH_right integrated LEFT=$XiR RIGHT=$Lsd+$Lg BOTTOM=0 TOP=$tsi P.CONC

material material=silicon taun0=$te taup0=$tp

models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel

output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps

method newton climit=100 itlimit=200 trap maxtraps=10

solve vfinal=-0.2 vstep=-0.05 name=gate
save outf=ROB_SR1e2_VG.str master

go atlas simflags="-P 1"
.begin
Vdrain 1 0 pwl 0, 0, 8.571429e-03, 6.0, 1.714286e-02, 0
Vgate  2 0 -0.2
Rtap   3 0 1e7
Adev 1=drain 0=source 2=gate 3=tap 0=substrate width=0.5 infile=ROB_SR1e2_VG.str
.nodeset v(1)=0 v(2)=-0.2 v(3)=0
.numeric lte=0.3 toltr=1e-5
.options print relpot
.log outfile=ROB_SR1e2.log
.tran 1e-9 1.714286e-02
.save master=ROB_SR1e2_T tsave=2.142857e-03 2.857143e-03 3.571429e-03 4.285714e-03 5.000000e-03 5.714286e-03 7.142857e-03 8.571429e-03 1.000000e-02 1.142857e-02 1.214286e-02 1.285714e-02 1.357143e-02 1.428571e-02 1.500000e-02 1.571429e-02 1.714286e-02
.end
contact name=tap workfun=4.17 surf.rec vsurfn=100 vsurfp=100

material material=silicon taun0=$te taup0=$tp
models print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel
output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps
method newton climit=100 itlimit=200 trap maxtraps=10

go atlas simflags="-P 1"
quit
