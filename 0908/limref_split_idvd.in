#=====================================================================
#  limref_split_idvd.in : Lim 치수 + 도핑 split (기준 소자와 1:1 비교)
#
#  limref_uniform_idvd.in 과 완전히 같은 소자에 body 도핑만 split 한다.
#  게이트가 0.50~1.00 이므로 xsplit = 0.75 는 정확히 절반이다.
#    source 쪽 0.50~0.75 : 1e17
#    drain  쪽 0.75~1.00 : 3e18
#  
#  두 덱의 차이는 도핑 split 하나뿐이므로, VLU / VLD / 래치 후 전류의
#  차이는 전부 split 탓이라고 말할 수 있다. 이것이 제안서가 필요로 하는
#  정식 대조 실험이다.
#  
#  주의 : limref_uniform 이 논문 값을 재현한 다음에 이 결과를 논해야
#  한다. 기준이 안 맞으면 차이가 split 때문인지 모델 때문인지 모른다.
#  
#  r1 = VG 0 / r2 = -0.5 / r3 = -1.0 / r4 = -1.5
#=====================================================================

set LDEV      = 1.50
set XG_L      = 0.50
set XG_R      = 1.00
set XS_END    = 0.50
set XD_START  = 1.00
set XSPLIT    = 0.75
set NA_SRC    = 1e17
set NA_DRN    = 3e18

set YTOP      = 0.00
set YPOLY_BOT = 0.05
set YOX_BOT   = 0.075
set YSI_BOT   = 0.175
set YBOX_BOT  = 0.375
set YSI_TOP   = $YOX_BOT
set STRFILE   = limref_split.str
set VD_MAX    = 6.0

set T_BIAS    = 2e-6
set T_SETTLE  = 5.2e-5
set T_UP      = 1.52e-4
set T_HD      = 1.62e-4
set T_DN      = 2.62e-4

loop steps=4

assign name=RUNID n.value=(1, 2, 3, 4)
assign name=VGVAL n.value=(0.0, -0.5, -1.0, -1.5)

go atlas simflag="-P 2"

mesh space.mult=1.0

x.mesh loc=0.00  spac=0.02
x.mesh loc=0.20  spac=0.01
x.mesh loc=0.45  spac=0.005
x.mesh loc=0.50  spac=0.002
x.mesh loc=0.65  spac=0.006
x.mesh loc=0.75  spac=0.004
x.mesh loc=0.85  spac=0.006
x.mesh loc=0.97  spac=0.002
x.mesh loc=1.00  spac=0.001
x.mesh loc=1.06  spac=0.003
x.mesh loc=1.30  spac=0.01
x.mesh loc=1.50  spac=0.02

y.mesh loc=0.000  spac=0.010
y.mesh loc=0.045  spac=0.005
y.mesh loc=0.050  spac=0.002
y.mesh loc=0.075  spac=0.0015
y.mesh loc=0.125  spac=0.004
y.mesh loc=0.175  spac=0.0015
y.mesh loc=0.250  spac=0.01
y.mesh loc=0.375  spac=0.02

region num=1 material=air \
       x.min=0.00   x.max=$XG_L  y.min=$YTOP    y.max=$YOX_BOT
region num=2 material=polysilicon \
       x.min=$XG_L  x.max=$XG_R  y.min=$YTOP    y.max=$YPOLY_BOT
region num=3 material=oxide \
       x.min=$XG_L  x.max=$XG_R  y.min=$YPOLY_BOT y.max=$YOX_BOT
region num=4 material=air \
       x.min=$XG_R  x.max=$LDEV  y.min=$YTOP    y.max=$YOX_BOT
region num=5 material=silicon \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_TOP y.max=$YSI_BOT
region num=6 material=oxide \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_BOT y.max=$YBOX_BOT

electrode name=gate   x.min=$XG_L x.max=$XG_R y.min=$YTOP y.max=$YTOP
electrode name=source x.min=0.00  x.max=0.00  y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=drain  x.min=$LDEV x.max=$LDEV y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=substrate bottom

doping uniform p.type conc=$NA_SRC \
       x.min=$XS_END   x.max=$XSPLIT   y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform p.type conc=$NA_DRN \
       x.min=$XSPLIT   x.max=$XD_START y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=0.00      x.max=$XS_END   y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=$XD_START x.max=$LDEV     y.min=$YSI_TOP y.max=$YSI_BOT

contact name=gate      n.poly
contact name=substrate p.poly

models cvt srh fermi bgn bbt.std print
impact selb
method newton trap maxtraps=20

output con.band val.band e.field ex.field ey.field flowlines \
       impact charge qfn qfp j.electron j.hole recomb

solve init
save outf=$STRFILE

go atlas simflag="-P 2"

.BEGIN

ASPLIT 1=drain 2=gate 0=source 3=substrate \
       INFILE=$STRFILE

VSUB 3 0 0

VG 2 0 PWL ( \
   0            0 \
   1e-6         0 \
   $T_BIAS      $VGVAL \
   $T_DN        $VGVAL )

VD 1 0 PWL ( \
   0            0 \
   $T_SETTLE    0 \
   $T_UP        $VD_MAX \
   $T_HD        $VD_MAX \
   $T_DN        0 )

.NUMERIC LTE=0.1 TOLTR=1e-6
.OPTIONS PRINT RELPOT WRITE=100000

.LOG OUTFILE=limref_split_r$RUNID
.TRAN 1e-10 $T_DN

.END

MODELS DEVICE=ASPLIT CVT SRH FERMI BGN BBT.STD
IMPACT DEVICE=ASPLIT SELB
METHOD NEWTON TRAP MAXTRAPS=20

PROBE DEVICE=ASPLIT NAME=vb_s  POTENTIAL X=0.60 Y=0.170
PROBE DEVICE=ASPLIT NAME=vb_d  POTENTIAL X=0.90 Y=0.170
PROBE DEVICE=ASPLIT NAME=vb_sm POTENTIAL X=0.60 Y=0.125
PROBE DEVICE=ASPLIT NAME=p_s   P.CONC    X=0.60 Y=0.170
PROBE DEVICE=ASPLIT NAME=p_d   P.CONC    X=0.90 Y=0.170
PROBE DEVICE=ASPLIT NAME=p_jn  P.CONC    X=0.99 Y=0.078

l.end

quit
