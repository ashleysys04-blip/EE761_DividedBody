#=====================================================================
#  tau_gidl_bbt.in
#  Split-body FDSOI (drain-side heavy) : 음의 게이트에서의 body 충전 시간
#
#  왜 다시 짜는가
#  ------------------------------------------------------------------
#  tau_eq_v3_bbt.in 은 GIDL 조건(VG<0, VD>0)이 t=1e-2 이후의 stage 2 에
#  있었는데, 그 앞 구간에서 dt 가 자라지 않아 거기까지 도달하지 못한다.
#  그래서 처음부터 음의 게이트를 걸어 GIDL 을 켠 상태로 시작한다.
#
#  bias
#  ------------------------------------------------------------------
#  VG 0 -> -0.5 V, VD 0 -> 1.0 V (1e-8 s 계단) 후 1e-2 s 까지 유지.
#  앞으로 쓸 IDVD sweep 의 VG = -0.5 조건과 같은 전기적 상태다.
#
#  판정
#  ------------------------------------------------------------------
#  baseline 과 bbt 를 겹쳐서 p_jn / p_drn 이 채워지는 속도를 비교한다.
#    bbt 가 훨씬 빠르다  -> GIDL 이 열생성보다 빠른 충전 경로를 제공한다.
#                          VG<0 조건에서는 램프 1e-4 s 가 정당화된다.
#    둘이 같다           -> 이 소자에서 BBT 는 충전 경로로 의미가 없다.
#                          램프를 늦추거나 비평형임을 명시하고 보고해야 한다.
#
#  dt 가 자라면 빨리 끝나고, 안 자라면 그 자체가 "여전히 느리다"는 답이다.
#  둘 다 정보이므로 오래 기다릴 필요는 없다. 2.6e-6 s 근처까지만 가도
#  p_jn 초기 기울기로 생성률을 비교할 수 있다.
#=====================================================================

go atlas simflag="-P 2"

# ---------------------------------------------------------------
# Structure (ver4 계열 공통, 경량 메시)
# ---------------------------------------------------------------
set LDEV      = 1.50
set XG_L      = 0.45
set XG_R      = 1.05
set XS_END    = 0.45
set XD_START  = 1.05
set X_SPLIT   = 0.75

set YTOP      = 0.00
set YPOLY_BOT = 0.05
set YOX_BOT   = 0.055
set YSI_BOT   = 0.075
set YBOX_BOT  = 0.275
set YSI_TOP   = $YOX_BOT

# drain-side heavy. 지금까지의 IDVG / IDVD 그림과 같은 구조.
set NA_SRC    = 1e17
set NA_DRN    = 3e18
set STRFILE   = tau_gidl_bbt.str

mesh space.mult=1.0

x.mesh loc=0.00  spac=0.02
x.mesh loc=0.15  spac=0.01
x.mesh loc=0.40  spac=0.005
x.mesh loc=0.45  spac=0.002
x.mesh loc=0.60  spac=0.008
x.mesh loc=0.72  spac=0.003
x.mesh loc=0.75  spac=0.001
x.mesh loc=0.78  spac=0.003
x.mesh loc=0.95  spac=0.008
x.mesh loc=1.02  spac=0.002
x.mesh loc=1.05  spac=0.001
x.mesh loc=1.10  spac=0.003
x.mesh loc=1.35  spac=0.01
x.mesh loc=1.50  spac=0.02

y.mesh loc=0.000  spac=0.010
y.mesh loc=0.045  spac=0.005
y.mesh loc=0.050  spac=0.001
y.mesh loc=0.055  spac=0.001
y.mesh loc=0.075  spac=0.001
y.mesh loc=0.150  spac=0.01
y.mesh loc=0.275  spac=0.02

region num=1 material=air \
       x.min=0.00   x.max=$XG_L  y.min=$YTOP    y.max=$YOX_BOT
region num=2 material=polysilicon \
       x.min=$XG_L  x.max=$XG_R  y.min=$YTOP    y.max=$YPOLY_BOT
region num=3 material=oxide \
       x.min=$XG_L  x.max=$XG_R  y.min=$YPOLY_BOT y.max=$YOX_BOT
region num=4 material=air \
       x.min=$XG_R  x.max=$LDEV  y.min=$YTOP    y.max=$YOX_BOT
region num=5 material=silicon \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_TOP y.max=$YSI_BOT
region num=6 material=oxide \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_BOT y.max=$YBOX_BOT

electrode name=gate   x.min=$XG_L x.max=$XG_R y.min=$YTOP y.max=$YTOP
electrode name=source x.min=0.00  x.max=0.00  y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=drain  x.min=$LDEV x.max=$LDEV y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=substrate bottom

doping uniform p.type conc=$NA_SRC \
       x.min=$XS_END   x.max=$X_SPLIT  y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform p.type conc=$NA_DRN \
       x.min=$X_SPLIT  x.max=$XD_START y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=0.00      x.max=$XS_END   y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=$XD_START x.max=$LDEV     y.min=$YSI_TOP y.max=$YSI_BOT

contact name=gate      n.poly
contact name=substrate n.poly

models cvt srh fermi bgn bbt.std print
impact selb
method newton trap maxtraps=20

output con.band val.band e.field ex.field ey.field flowlines \
       impact charge qfn qfp j.electron j.hole recomb

solve init
save outf=$STRFILE

# =====================================================================
#  Bias step + long hold  (단일 stage)
# =====================================================================
#  0     ~ 1e-9  : 전부 0
#  1e-9  ~ 1e-8  : VG 0 -> -0.5,  VD 0 -> 1.0   (계단)
#  1e-8  ~ 1e-2  : 유지. GIDL 로 body 가 채워지는 과정 관찰
# =====================================================================
set VG_OFF    = -0.5
set VD_HIGH   = 1.0

set T_RISE    = 1e-8
set T_END     = 1e-2

go atlas simflag="-P 2"

.BEGIN

ASPLIT 1=drain 2=gate 0=source 3=substrate \
       INFILE=$STRFILE

VSUB 3 0 0

VG 2 0 PWL ( \
   0            0 \
   1e-9         0 \
   $T_RISE      $VG_OFF \
   $T_END       $VG_OFF )

VD 1 0 PWL ( \
   0            0 \
   1e-9         0 \
   $T_RISE      $VD_HIGH \
   $T_END       $VD_HIGH )

# 고정 bias 구간이라 dt 가 크게 자란다. LTE 를 과하게 조이면
# 그 이점이 사라지므로 0.1 로 둔다.
.NUMERIC LTE=0.1 TOLTR=1e-6

.OPTIONS PRINT RELPOT WRITE=100000

.LOG OUTFILE=tau_gidl_bbt

.TRAN 1e-11 $T_END

.END

MODELS DEVICE=ASPLIT CVT SRH FERMI BGN BBT.STD
IMPACT DEVICE=ASPLIT SELB
METHOD NEWTON TRAP MAXTRAPS=20

PROBE DEVICE=ASPLIT NAME=vb_src POTENTIAL X=0.60 Y=0.070
PROBE DEVICE=ASPLIT NAME=vb_drn POTENTIAL X=0.90 Y=0.070
PROBE DEVICE=ASPLIT NAME=p_src  P.CONC    X=0.60 Y=0.070
PROBE DEVICE=ASPLIT NAME=p_drn  P.CONC    X=0.90 Y=0.070
PROBE DEVICE=ASPLIT NAME=p_jn   P.CONC    X=1.04 Y=0.058

quit
