#=====================================================================
#  ver4_cycling_recovery.in
#  Split-body FDSOI : cycle-to-cycle 차이의 원인 규명 (A) 물리 쪽
#
#  가설 A : 사이클 사이에 floating body 의 잔류 정공이 다 빠지지 않아서
#           다음 사이클의 초기 상태가 달라진다 (deterministic history).
#
#  검증 방법
#  ------------------------------------------------------------------
#  (1) 1번 사이클 전에 충분한 settle 시간(100 us)을 준다.
#      기존 덱은 VG 램프가 끝나는 2 us 에 바로 1번 사이클이 시작했다.
#  (2) 사이클 사이에 rest 시간을 넣고, 그 값을 0 / 10us / 100us / 1ms 로
#      스캔한다. PULSE 의 period 를 rise+width+fall 보다 크게 잡으면
#      남는 시간 동안 v1(=0 V) 에 머문다.
#  (3) PROBE 로 body potential 과 hole 농도를 시간축에 기록해서,
#      각 사이클이 시작하는 순간(VD=0, 램프 직전)의 상태를 비교한다.
#
#  판정
#  ------------------------------------------------------------------
#   rest 시간이 길어질수록 사이클 간 차이가 줄어든다
#       -> 가설 A 맞음. 잔류 body charge 의 완화 시상수 tau_rec 를
#          rest-time 의존성에서 추출할 수 있다. 이건 실제 결과가 된다.
#   rest 시간과 무관하게 차이가 그대로다
#       -> 물리가 아니다. ver4_numerics_cycling.in 으로 넘어갈 것.
#   각 사이클 시작 시점의 vb_src / p_src 가 서로 같은데 곡선만 다르다
#       -> 초기 상태가 같으므로 100% 수치 문제다.
#=====================================================================

go atlas simflag="-P 2"

# ---------------------------------------------------------------
# Structure (ver4 계열 공통)
# ---------------------------------------------------------------
set LDEV      = 1.50
set XG_L      = 0.45
set XG_R      = 1.05
set XS_END    = 0.45
set XD_START  = 1.05
set X_SPLIT   = 0.75

set YTOP      = 0.00
set YPOLY_BOT = 0.05
set YOX_BOT   = 0.055
set YSI_BOT   = 0.075
set YBOX_BOT  = 0.275
set YSI_TOP   = $YOX_BOT

# ver3_sourceside.in 과 같은 조건 (source-side heavy)
set NA_SRC    = 3e18
set NA_DRN    = 1e17
set STRFILE   = split_ss_cyc.str   # 덱마다 고유

mesh space.mult=1.0

x.mesh loc=0.00  spac=0.02
x.mesh loc=0.15  spac=0.005
x.mesh loc=0.45  spac=0.002
x.mesh loc=0.60  spac=0.01
x.mesh loc=0.68  spac=0.002
x.mesh loc=0.70  spac=0.001
x.mesh loc=0.75  spac=0.001
x.mesh loc=0.80  spac=0.001
x.mesh loc=0.82  spac=0.002
x.mesh loc=0.90  spac=0.01
x.mesh loc=1.05  spac=0.002
x.mesh loc=1.35  spac=0.005
x.mesh loc=1.50  spac=0.02

y.mesh loc=0.000  spac=0.002
y.mesh loc=0.050  spac=0.001
y.mesh loc=0.055  spac=0.0005
y.mesh loc=0.075  spac=0.0005
y.mesh loc=0.150  spac=0.01
y.mesh loc=0.275  spac=0.02

region num=1 material=air \
       x.min=0.00   x.max=$XG_L  y.min=$YTOP    y.max=$YOX_BOT
region num=2 material=polysilicon \
       x.min=$XG_L  x.max=$XG_R  y.min=$YTOP    y.max=$YPOLY_BOT
region num=3 material=oxide \
       x.min=$XG_L  x.max=$XG_R  y.min=$YPOLY_BOT y.max=$YOX_BOT
region num=4 material=air \
       x.min=$XG_R  x.max=$LDEV  y.min=$YTOP    y.max=$YOX_BOT
region num=5 material=silicon \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_TOP y.max=$YSI_BOT
region num=6 material=oxide \
       x.min=0.00   x.max=$LDEV  y.min=$YSI_BOT y.max=$YBOX_BOT

electrode name=gate   x.min=$XG_L x.max=$XG_R y.min=$YTOP y.max=$YTOP
electrode name=source x.min=0.00  x.max=0.00  y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=drain  x.min=$LDEV x.max=$LDEV y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=substrate bottom

doping uniform p.type conc=$NA_SRC \
       x.min=$XS_END   x.max=$X_SPLIT  y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform p.type conc=$NA_DRN \
       x.min=$X_SPLIT  x.max=$XD_START y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=0.00      x.max=$XS_END   y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=$XD_START x.max=$LDEV     y.min=$YSI_TOP y.max=$YSI_BOT

contact name=gate      n.poly
contact name=substrate n.poly

models cvt srh fermi bgn print
impact selb
method newton trap maxtraps=20

output con.band val.band e.field ex.field ey.field flowlines \
       impact charge qfn qfp j.electron j.hole recomb

solve init
save outf=$STRFILE

# =====================================================================
#  Cycling with rest time
# =====================================================================
#  타이밍
#     0       ~ 1e-6    : 전부 0
#     1e-6    ~ 2e-6    : VG 0 -> 2.9 V
#     2e-6    ~ 1e-4    : SETTLE (약 100 us). 여기가 기존 덱에 없던 부분
#     1e-4    부터      : VD 사이클 시작
#
#  1 사이클 = rise 1e-4 + top hold 1e-5 + fall 1e-4 + rest
#           = 2.1e-4 + rest
#
#  rest      period     cycle1     cycle2     cycle3
#  ------------------------------------------------------------
#  0         2.10e-4    3.10e-4    5.20e-4    7.30e-4
#  1e-5      2.20e-4    3.20e-4    5.40e-4    7.60e-4
#  1e-4      3.10e-4    4.10e-4    7.20e-4    1.03e-3
#  1e-3      1.21e-3    1.31e-3    2.52e-3    3.73e-3
#
#  ※ rest=1e-3 케이스는 총 3.73 ms 라 꽤 오래 걸린다. 급하면 이 조건만
#     따로 nohup 으로 돌릴 것.
# =====================================================================
set VG_TGT   = 2.9
set VD_MAX   = 5.0
set T_VG_END = 2e-6
set T_START  = 1e-4      # 첫 사이클 시작 시각 (= settle 끝)
set T_RAMP   = 1e-4
set T_TOP    = 1e-5

loop steps=4

# r1 = rest 0 / r2 = rest 10us / r3 = rest 100us / r4 = rest 1ms
assign name=RID   n.value=(1, 2, 3, 4)
assign name=T_PER n.value=(2.10e-4, 2.20e-4, 3.10e-4, 1.21e-3)
assign name=T_C1  n.value=(3.10e-4, 3.20e-4, 4.10e-4, 1.31e-3)
assign name=T_C2  n.value=(5.20e-4, 5.40e-4, 7.20e-4, 2.52e-3)
assign name=T_C3  n.value=(7.30e-4, 7.60e-4, 1.03e-3, 3.73e-3)

go atlas simflag="-P 2"

.BEGIN

ASPLIT 1=drain 2=gate 0=source 3=substrate \
       INFILE=$STRFILE

VSUB 3 0 0

VG 2 0 PWL ( \
   0            0 \
   1e-6         0 \
   $T_VG_END    $VG_TGT \
   $T_C3        $VG_TGT )

# PULSE ( v1 v2 delay rise fall width period )
# period > rise+width+fall 이므로 남는 시간 동안 0 V 에 머문다 = rest
VD 1 0 PULSE ( \
   0 $VD_MAX \
   $T_START \
   $T_RAMP $T_RAMP \
   $T_TOP  $T_PER )

# 사이클 간 차이를 볼 거면 solver 경로 차이부터 죽여놔야 한다.
# ver3 의 LTE=0.3 / TOLTR=1e-5 보다 확실히 조인 값.
.NUMERIC LTE=0.02 TOLTR=1e-8

.OPTIONS PRINT RELPOT WRITE=100000

# --- settle 구간. 이 로그에서 body 가 정말 정착했는지 먼저 확인할 것 ---
.LOG OUTFILE=settle_cyc_ss_r$RID
.TRAN 1e-9 $T_START

.LOG OUTFILE=c1_cyc_ss_r$RID
.TRAN 1e-9 $T_C1

.LOG OUTFILE=c2_cyc_ss_r$RID
.TRAN 1e-9 $T_C2

.LOG OUTFILE=c3_cyc_ss_r$RID
.TRAN 1e-9 $T_C3

.END

MODELS DEVICE=ASPLIT CVT SRH FERMI BGN
IMPACT DEVICE=ASPLIT SELB
METHOD NEWTON TRAP MAXTRAPS=20

# 각 사이클 시작 순간의 body 상태를 직접 읽기 위한 probe.
# 이 값들이 사이클마다 같으면 초기조건이 같다는 뜻이고,
# 그런데도 ID-VD 가 다르면 원인은 물리가 아니라 solver 다.
PROBE DEVICE=ASPLIT NAME=vb_src POTENTIAL X=0.60 Y=0.070
PROBE DEVICE=ASPLIT NAME=vb_drn POTENTIAL X=0.90 Y=0.070
PROBE DEVICE=ASPLIT NAME=p_src  P.CONC    X=0.60 Y=0.070
PROBE DEVICE=ASPLIT NAME=p_drn  P.CONC    X=0.90 Y=0.070

l.end

quit
