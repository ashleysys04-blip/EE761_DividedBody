#=====================================================================
#  win_idvg_lg.in : 게이트 길이로 기생 BJT 이득을 낮춰 래치 창을 닫는다
#
#  기생 BJT 이득 beta 는 베이스 길이(= 게이트 길이)에 강하게 의존한다.
#  GIDL 기법으로 측정한 보고값이 0.25 um 에서 28.75, 1 um 에서 1.52 로
#  20 배 가까이 차이난다. 지금 Lg = 0.6 um 인데 이걸 늘리면 이득이
#  떨어지고 VLD 가 올라가 창이 닫힐 것으로 기대한다.
#
#  구조 규칙
#    게이트는 body 를 정확히 덮는다 (XS_END ~ XD_START)
#    split 은 게이트 중앙
#    source / drain extension 은 각각 0.45 um 로 고정 -> 직렬저항 동일
#    따라서 Lg 가 늘면 소자 전체 길이 LDEV 도 같이 늘어난다
#
#  x.mesh 위치를 전부 assign 으로 뺐다. Lg 가 바뀌면 junction 과 split
#  자리도 옮겨가므로 세밀화가 따라가야 하기 때문이다. PROBE 좌표도 같은
#  이유로 assign 이다.
#
#  VD 를 두 값 준 이유 : Lg 가 길어지면 같은 VD 에서 전계가 낮아져
#  VLU 가 올라간다. 1.0 V 에서 Lg=1.5 가 아예 안 걸릴 수 있어 2.5 V 를
#  같이 돌린다. 둘 다 안 걸리면 VD 를 더 올릴 것.
#
#  r1 : Lg=0.6 um, VD=1.0 V, xsplit=0.75, XD=1.05, LDEV=1.5
#  r2 : Lg=0.6 um, VD=2.5 V, xsplit=0.75, XD=1.05, LDEV=1.5
#  r3 : Lg=1.0 um, VD=1.0 V, xsplit=0.95, XD=1.45, LDEV=1.9
#  r4 : Lg=1.0 um, VD=2.5 V, xsplit=0.95, XD=1.45, LDEV=1.9
#  r5 : Lg=1.5 um, VD=1.0 V, xsplit=1.2, XD=1.95, LDEV=2.4
#  r6 : Lg=1.5 um, VD=2.5 V, xsplit=1.2, XD=1.95, LDEV=2.4
#=====================================================================

set XS_END    = 0.45
set NA_SRC    = 1e17
set NA_DRN    = 3e18

set YTOP      = 0.00
set YPOLY_BOT = 0.05
set YOX_BOT   = 0.055
set YSI_BOT   = 0.075
set YBOX_BOT  = 0.275
set YSI_TOP   = $YOX_BOT

set VG_LO     = -2.0
set VG_HI     = 3.0
set STRFILE   = win_lg.str

set T_BIAS    = 2e-6
set T_SETTLE  = 5.2e-5
set T_UP      = 1.52e-4
set T_HD      = 1.62e-4
set T_DN      = 2.62e-4

loop steps=6

assign name=RUNID    n.value=(1, 2, 3, 4, 5, 6)
assign name=VDVAL    n.value=(1.0, 2.5, 1.0, 2.5, 1.0, 2.5)
assign name=LGV      n.value=(0.6, 0.6, 1.0, 1.0, 1.5, 1.5)
assign name=XM1      n.value=(0.6, 0.6, 0.7, 0.7, 0.825, 0.825)
assign name=XM2      n.value=(0.72, 0.72, 0.92, 0.92, 1.17, 1.17)
assign name=XSPLIT   n.value=(0.75, 0.75, 0.95, 0.95, 1.2, 1.2)
assign name=XM3      n.value=(0.78, 0.78, 0.98, 0.98, 1.23, 1.23)
assign name=XM4      n.value=(0.9, 0.9, 1.2, 1.2, 1.575, 1.575)
assign name=XM5      n.value=(1.02, 1.02, 1.42, 1.42, 1.92, 1.92)
assign name=XD_START n.value=(1.05, 1.05, 1.45, 1.45, 1.95, 1.95)
assign name=XM6      n.value=(1.1, 1.1, 1.5, 1.5, 2.0, 2.0)
assign name=XM7      n.value=(1.35, 1.35, 1.75, 1.75, 2.25, 2.25)
assign name=LDEV     n.value=(1.5, 1.5, 1.9, 1.9, 2.4, 2.4)
assign name=PS       n.value=(0.5, 0.5, 0.5, 0.5, 0.5, 0.5)
assign name=PD       n.value=(1.0, 1.0, 1.4, 1.4, 1.9, 1.9)
assign name=PJ       n.value=(1.04, 1.04, 1.44, 1.44, 1.94, 1.94)

go atlas simflag="-P 2"

mesh space.mult=1.0

x.mesh loc=0.00       spac=0.02
x.mesh loc=0.15       spac=0.01
x.mesh loc=0.40       spac=0.005
x.mesh loc=$XS_END    spac=0.002
x.mesh loc=$XM1       spac=0.008
x.mesh loc=$XM2       spac=0.003
x.mesh loc=$XSPLIT    spac=0.001
x.mesh loc=$XM3       spac=0.003
x.mesh loc=$XM4       spac=0.008
x.mesh loc=$XM5       spac=0.002
x.mesh loc=$XD_START  spac=0.001
x.mesh loc=$XM6       spac=0.003
x.mesh loc=$XM7       spac=0.01
x.mesh loc=$LDEV      spac=0.02

y.mesh loc=0.000  spac=0.010
y.mesh loc=0.045  spac=0.005
y.mesh loc=0.050  spac=0.001
y.mesh loc=0.055  spac=0.001
y.mesh loc=0.075  spac=0.001
y.mesh loc=0.150  spac=0.01
y.mesh loc=0.275  spac=0.02

region num=1 material=air \
       x.min=0.00       x.max=$XS_END    y.min=$YTOP    y.max=$YOX_BOT
region num=2 material=polysilicon \
       x.min=$XS_END    x.max=$XD_START  y.min=$YTOP    y.max=$YPOLY_BOT
region num=3 material=oxide \
       x.min=$XS_END    x.max=$XD_START  y.min=$YPOLY_BOT y.max=$YOX_BOT
region num=4 material=air \
       x.min=$XD_START  x.max=$LDEV      y.min=$YTOP    y.max=$YOX_BOT
region num=5 material=silicon \
       x.min=0.00       x.max=$LDEV      y.min=$YSI_TOP y.max=$YSI_BOT
region num=6 material=oxide \
       x.min=0.00       x.max=$LDEV      y.min=$YSI_BOT y.max=$YBOX_BOT

electrode name=gate   x.min=$XS_END x.max=$XD_START y.min=$YTOP y.max=$YTOP
electrode name=source x.min=0.00    x.max=0.00      y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=drain  x.min=$LDEV   x.max=$LDEV     y.min=$YSI_TOP y.max=$YSI_BOT
electrode name=substrate bottom

doping uniform p.type conc=$NA_SRC \
       x.min=$XS_END    x.max=$XSPLIT    y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform p.type conc=$NA_DRN \
       x.min=$XSPLIT    x.max=$XD_START  y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=0.00       x.max=$XS_END    y.min=$YSI_TOP y.max=$YSI_BOT
doping uniform n.type conc=1e20 \
       x.min=$XD_START  x.max=$LDEV      y.min=$YSI_TOP y.max=$YSI_BOT

contact name=gate      n.poly
contact name=substrate n.poly

models cvt srh fermi bgn print
impact selb
method newton trap maxtraps=20

output con.band val.band e.field ex.field ey.field flowlines \
       impact charge qfn qfp j.electron j.hole recomb

solve init
save outf=$STRFILE

go atlas simflag="-P 2"

.BEGIN

ASPLIT 1=drain 2=gate 0=source 3=substrate \
       INFILE=$STRFILE

VSUB 3 0 0

VD 1 0 PWL ( \
   0            0 \
   1e-6         0 \
   $T_BIAS      $VDVAL \
   $T_DN        $VDVAL )

VG 2 0 PWL ( \
   0            0 \
   1e-6         0 \
   $T_BIAS      $VG_LO \
   $T_SETTLE    $VG_LO \
   $T_UP        $VG_HI \
   $T_HD        $VG_HI \
   $T_DN        $VG_LO )

.NUMERIC LTE=0.1 TOLTR=1e-6
.OPTIONS PRINT RELPOT WRITE=100000

.LOG OUTFILE=win_lg_r$RUNID
.TRAN 1e-10 $T_DN

.END

MODELS DEVICE=ASPLIT CVT SRH FERMI BGN
IMPACT DEVICE=ASPLIT SELB
METHOD NEWTON TRAP MAXTRAPS=20

PROBE DEVICE=ASPLIT NAME=vb_s  POTENTIAL X=$PS Y=0.070
PROBE DEVICE=ASPLIT NAME=vb_d  POTENTIAL X=$PD Y=0.070
PROBE DEVICE=ASPLIT NAME=p_s   P.CONC    X=$PS Y=0.070
PROBE DEVICE=ASPLIT NAME=p_d   P.CONC    X=$PD Y=0.070
PROBE DEVICE=ASPLIT NAME=p_jn  P.CONC    X=$PJ Y=0.058

l.end

quit
