# HCD_W120_KILL : device-only transient version of HC_W120_KILL (make_hcte_dev.py); hcte, tap resistance 5e6 Ohm*um, 0 -> 6 -> 0 V.
# HCD_W120_KILL : hcte (energy balance) check, generated by 1103_hcte/make_hcte.py from 1030_islw/ISLW120_KILL.in
# Changes: hcte + block Newton; drain 0 -> 6 -> 0 V at 0.7 V/ms. Snapshots (HCD_W120_KILL_T_tr_N): up 1.5, 2, 2.5, 3, 3.5, 4, 5, 6 / down 5, 4, 3.5, 3, 2.5, 2, 1.5, 1, 0 V
# HCD_W120_KILL : island-width sweep, generated by 1030_islw/make_islw.py from 1010_sink/NOKILL_TE8_XS60.in
# Changes: island width 30 -> 120 nm with both body lengths kept (Lg = 0.27 um + W), drain mesh and probes moved, island + neck lifetime killed (1e-12 s).
# HCD_W120_KILL : from DDS_TE8_XS60. Island lifetime NOT killed (control), tap at the bottom of the n+ neck. Generated by 1010_sink/make_sink.py
# HCD_W120_KILL : DD MixedMode split. Changed vs base: Si lifetime 1e-8 s + island at 60 % of Lg.
# Generated by 1007_ddsplit/make_ddsplit.py from 1001/tap/MM_TAPT_ISL_W30LK_L6_R7_R1e7_UD75S_MF_DD_W05_VGm0p2.in
# Sweep 0 -> 6.0 -> 0 V at 0.7 V/ms. Snapshots (HCD_W120_KILL_T_tr_N): up 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 5.0, 6.0 / down 5.0, 4.0, 3.5, 3.0, 2.5, 2.0, 1.5, 1.0, 0.0 V
# ============================================================
# HCD_W120_KILL : DD MixedMode rerun with A-device width=0.5 (the first DD run computed a 1 um wide device), same as the hcte runs.
# Device = B structure, left 6e17 / right 7e17, lifetime-killed island, fine mesh. Circuit: Vdrain pwl 0 -> 7.5 -> 0 V at 0.7 V/ms,
# Vgate -0.2 V, tap -> Rtap 1e7 Ohm -> GND. Structure + gate bias prepared as .str, then loaded by the A-device.
# ============================================================
# HCD_W120_KILL : TAPPED n+ island, lifetime-killed island, LEFT body 6e17 (2nd-latch candidate)
# The island is tied to ground through an n+ neck in the BOX and a
# series resistor R = 5000000 (ATLAS 2D units Ohm*um -> 1e+07 Ohm effective) on electrode 'tap'.
# Purpose: break the series constraint of the floating island so that the
# right STL can latch alone (current -> island -> R), lifting the island to
# I*R, which then acts as the drain bias of the left STL (2nd latch).
# TRANSIENT drain ramp at 0.7 V/ms: 0 -> 7.5 -> 0 V, .str snapshots for EBD at
# see solve list below.
# Unstable branches are crossed by real time dynamics -> latch jumps + hysteresis appear directly.
# An S-shaped (snapback) I-V is single-valued in current, so every latch
# shows up as a negative-slope (NDR) segment of V_D(I_D). Count NDR segments.
# VG = -0.2 V.
# Base structure (unchanged otherwise):
# n+ island (30 nm, 1e20, full Tsi) at mid-channel under the same gate
# LIFETIME-KILLED island: island (and tap neck) carrier lifetimes set to 1e-12 s so that holes
# injected from the right body recombine inside the island instead of reaching the left body
# (kills the lateral PNP right-body / n+ island / left-body that coupled the two latches).
# Left body = 6e17 (standalone left STL 6e17/135 nm latches sharply at 2.539 V), right body = 7e17
# Left body: source = S.   Right body: source = island.
# -> two parasitic BJTs / two feedback loops in series.
# CPU = 1
# MAIN RUN, MESH-FINE (MF): right drain junction x = 0.76-0.815 um at 1 nm, surface y 2 nm (same as TAPT_ISL_W30LK_L3_R7_R1e6_UD7S_MF).
# Left body 6e17 (standalone hcte: latch 2.541 V, turn-off 2.48-2.32 V). R = 1e7 Ohm: island +2.54 V needs only 2.5e-7 A,
# keeping the right STL near 3.0 V (all R1e6 runs stopped at 3.35-3.7 V across the right STL). Expected 2nd latch near Vd ~ 6.1 V.

go atlas simflags="-P 1"

set Lg = 0.39
set Lsd = 0.5
set tox = 0.02
set tbox = 0.2
set tgate = 0.1
set te = 1e-8
set tp = 1e-8
set LT = 300
set Xsplit = $Lsd+0.165+0.06
set W = 0.5
set tsi = 0.05
set Wisl = 0.12
set XiL = $Xsplit-$Wisl/2
set XiR = $Xsplit+$Wisl/2
set Ybot = $tsi+$tbox

#### mesh define ####
mesh space.mult = 1.0 width = $W

x.mesh loc=0.00 spac=0.1
x.mesh loc=$Lsd spac=0.005
x.mesh loc=$XiL spac=0.003
x.mesh loc=$XiR spac=0.003
x.mesh loc=$Lsd+$Lg-0.04 spac=0.003
x.mesh loc=$Lsd+$Lg-0.015 spac=0.001
x.mesh loc=$Lsd+$Lg spac=0.001
x.mesh loc=$Lsd+$Lg+0.015 spac=0.003
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.1

y.mesh loc=-$tox-$tgate spac=0.05
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.002
y.mesh loc=$tsi/2 spac=0.01
y.mesh loc=$tsi spac=0.005
y.mesh loc=$tsi+0.05 spac=0.02
y.mesh loc=$Ybot-0.03 spac=0.01
y.mesh loc=$Ybot spac=0.005

#### regions ####
region num=1 x.min=$Lsd x.max=$Lsd+$Lg y.max=-$tox poly
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$tsi silicon
region num=4 x.min=0 x.max=$Lsd y.min=0 y.max=$tsi silicon
region num=5 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.min=0 y.max=$tsi silicon
region num=6 y.min=$tsi y.max=$tsi+$tbox oxide
region num=7 x.min=0 x.max=$Lsd y.max=0 material=vacuum
region num=8 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.max=0 material=vacuum
# n+ neck through the BOX under the island (island tap)
region num=9 x.min=$XiL x.max=$XiR y.min=$tsi y.max=$Ybot silicon
# n+ island as a separate silicon region (for region-specific lifetime)
region num=10 x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi silicon

#### electrodes ####
electrode name=gate x.min=$Lsd x.max=$Lsd+$Lg y.min=-$tox y.max=-$tox
electrode name=source x.max=$Lsd y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg y.min=0 y.max=0
electrode name=tap x.min=$XiL x.max=$XiR y.min=$Ybot y.max=$Ybot
electrode name=substrate x.max=$XiL-0.03 y.min=$Ybot y.max=$Ybot
electrode name=substrate x.min=$XiR+0.03 y.min=$Ybot y.max=$Ybot

#### doping ####
doping uniform conc=6.0e17 p.type x.min=$Lsd x.max=$XiL y.min=0 y.max=$tsi
doping uniform conc=7.0e17 p.type x.min=$XiR x.max=$Lsd+$Lg y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type reg=9
doping uniform conc=1e20 n.type reg=4
doping uniform conc=1e20 n.type reg=5
doping uniform conc=1e21 n.type reg=1

save outf=HCD_W120_KILL_INIT.str

#### contacts ####
contact name=drain
contact name=source
contact name=substrate
contact name=tap resistance=5e6
# island tap to ground through a series resistor
# tap: no contact resistance here; the 1e7 Ohm resistor is a MixedMode circuit element

#### probes ####
probe name=VB_left  potential x=0.5675 y=0.035
probe name=VB_right potential x=$XiR+0.0375 y=0.035
probe name=V_island potential x=$Xsplit y=0.025
probe name=V_neck   potential x=$Xsplit y=0.15
probe name=PH_left  P.CONC x=0.5675 y=0.035
probe name=PH_right P.CONC x=0.7325 y=0.035
probe name=QH_left  integrated LEFT=$Lsd RIGHT=$XiL BOTTOM=0 TOP=$tsi P.CONC
probe name=QH_right integrated LEFT=$XiR RIGHT=$Lsd+$Lg BOTTOM=0 TOP=$tsi P.CONC

#### physical models ####
material material=silicon taun0=$te taup0=$tp
# lifetime killing in the island and its tap neck
material region=10 taun0=1e-12 taup0=1e-12
material region=9 taun0=1e-12 taup0=1e-12

models print bgn hcte consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel

output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps

#### numerical method ####
method block newton climit=100 itlimit=200 NBLOCKIT=200 trap maxtraps=10

#### gate bias ####
solve vfinal=-0.2 vstep=-0.05 name=gate
save outf=HCD_W120_KILL_VG.str


#### drain ramp 0 -> 6 -> 0 V at 0.7 V/ms (device-only transient, tap through contact resistance) ####
log outf=HCD_W120_KILL.log
solve vdrain=1.5 ramptime=2.142857e-03 tstop=2.142857e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_1
solve vdrain=2 ramptime=7.142857e-04 tstop=2.857143e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_2
solve vdrain=2.5 ramptime=7.142857e-04 tstop=3.571429e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_3
solve vdrain=3 ramptime=7.142857e-04 tstop=4.285714e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_4
solve vdrain=3.5 ramptime=7.142857e-04 tstop=5.000000e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_5
solve vdrain=4 ramptime=7.142857e-04 tstop=5.714286e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_6
solve vdrain=5 ramptime=1.428571e-03 tstop=7.142857e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_7
solve vdrain=6 ramptime=1.428571e-03 tstop=8.571429e-03 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_8
solve vdrain=5 ramptime=1.428571e-03 tstop=1.000000e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_9
solve vdrain=4 ramptime=1.428571e-03 tstop=1.142857e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_10
solve vdrain=3.5 ramptime=7.142857e-04 tstop=1.214286e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_11
solve vdrain=3 ramptime=7.142857e-04 tstop=1.285714e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_12
solve vdrain=2.5 ramptime=7.142857e-04 tstop=1.357143e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_13
solve vdrain=2 ramptime=7.142857e-04 tstop=1.428571e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_14
solve vdrain=1.5 ramptime=7.142857e-04 tstop=1.500000e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_15
solve vdrain=1 ramptime=7.142857e-04 tstop=1.571429e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_16
solve vdrain=0 ramptime=1.428571e-03 tstop=1.714286e-02 tstep=1e-9
save outf=HCD_W120_KILL_T_tr_17

quit
