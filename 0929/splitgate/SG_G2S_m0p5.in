# ============================================================
# Split-gate STL (SG_G2S_m0p5)
# Uniform body 5.0e17. G1 (main gate) = -0.2 V, G2 = -0.5 V over the
# SOURCE-side half of the channel, 10 nm oxide gap.
# Idea: G2 electrostatically dopes one half (accumulation <-> depletion),
# i.e. a programmable version of the doping split. Previous doping-split
# data: depleting the drain-side half widened the latch window 0.35 -> 1.66 V.
# CPU = 2
# ============================================================

go atlas simflags="-P 2"

set Lg = 0.3
set Lsd = 0.5
set tsi = 0.05
set tox = 0.02
set tbox = 0.2
set tgate = 0.1
set W = 0.5
set te = 1e-7
set tp = 1e-7
set LT = 300
set Xsplit = $Lsd+$Lg*0.50
set Wgap = 0.01

#### mesh define ####
mesh space.mult = 1.0 width = $W

x.mesh loc=0.00 spac=0.1
x.mesh loc=$Lsd spac=0.01
x.mesh loc=$Xsplit-$Wgap/2 spac=0.003
x.mesh loc=$Xsplit+$Wgap/2 spac=0.003
x.mesh loc=$Lsd+$Lg spac=0.005
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.1

y.mesh loc=-$tox-$tgate spac=0.05
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.005
y.mesh loc=$tsi/2 spac=0.01
y.mesh loc=$tsi spac=0.005
y.mesh loc=$tsi+$tbox spac=0.1

#### regions ####
region num=1 x.min=$Xsplit+$Wgap/2 x.max=$Lsd+$Lg y.max=-$tox poly
region num=9 x.min=$Lsd x.max=$Xsplit-$Wgap/2 y.max=-$tox poly
region num=10 x.min=$Xsplit-$Wgap/2 x.max=$Xsplit+$Wgap/2 y.max=-$tox oxide
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$tsi silicon
region num=4 x.min=0 x.max=$Lsd y.min=0 y.max=$tsi silicon
region num=5 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.min=0 y.max=$tsi silicon
region num=6 y.min=$tsi y.max=$tsi+$tbox oxide
region num=7 x.min=0 x.max=$Lsd y.max=0 material=vacuum
region num=8 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.max=0 material=vacuum

#### electrodes ####
electrode name=gate x.min=$Xsplit+$Wgap/2 x.max=$Lsd+$Lg y.min=-$tox y.max=-$tox
electrode name=source x.max=$Lsd y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg y.min=0 y.max=0
electrode name=cgate x.min=$Lsd x.max=$Xsplit-$Wgap/2 y.min=-$tox y.max=-$tox
electrode substrate

#### doping ####
doping uniform conc=5.0e17 p.type reg=3
doping uniform conc=1e20 n.type reg=4
doping uniform conc=1e20 n.type reg=5
doping uniform conc=1e21 n.type reg=1
doping uniform conc=1e21 n.type reg=9

save outf=SG_G2S_m0p5_INIT.str

#### contacts ####
contact name=drain
contact name=source
contact name=substrate

#### probes ####
probe name=VB_left  potential x=0.575 y=0.035
probe name=VB_right potential x=0.725 y=0.035
probe name=PH_left  P.CONC x=0.575 y=0.035
probe name=PH_right P.CONC x=0.725 y=0.035
probe name=QH_left  integrated LEFT=$Lsd RIGHT=$Xsplit BOTTOM=0 TOP=$tsi P.CONC
probe name=QH_right integrated LEFT=$Xsplit RIGHT=$Lsd+$Lg BOTTOM=0 TOP=$tsi P.CONC

#### physical models ####
material material=silicon taun0=$te taup0=$tp

models print bgn hcte consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel

output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps

#### numerical method ####
method block newton climit=100 itlimit=200 NBLOCKIT=200 trap maxtraps=10

#### gate biases ####
solve vfinal=-0.2 vstep=-0.05 name=gate
solve vfinal=-0.5 vstep=-0.05 name=cgate
save outf=SG_G2S_m0p5_HRS.str

#### log ####
log outf=SG_G2S_m0p5.log j.electron j.hole

# ---------------- FORWARD : 0 -> 7 V ----------------
solve vdrain=0 vfinal=2.5 vstep=0.05 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_FWD_2p5.str
solve vfinal=4.0 vstep=0.002 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_FWD_4p0.str
solve vfinal=6.0 vstep=0.002 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_FWD_6p0.str
solve vfinal=7.0 vstep=0.02 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_FWD_7p0.str

# ---------------- REVERSE : 7 -> 0 V ----------------
solve vfinal=6.0 vstep=-0.02 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_REV_6p0.str
solve vfinal=4.0 vstep=-0.002 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_REV_4p0.str
solve vfinal=2.5 vstep=-0.002 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_REV_2p5.str
solve vfinal=0.0 vstep=-0.05 name=drain cname=drain compl=1e-2
save outf=SG_G2S_m0p5_END.str

log off
quit
