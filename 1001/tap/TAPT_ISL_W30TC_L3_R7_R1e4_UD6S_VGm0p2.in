# ============================================================
# TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2 : TAPPED n+ island (contacted-island cascaded latch)
# The island is tied to ground through an n+ neck in the BOX and a
# series resistor R = 5000 (ATLAS 2D units Ohm*um -> 1e+04 Ohm effective) on electrode 'tap'.
# Purpose: break the series constraint of the floating island so that the
# right STL can latch alone (current -> island -> R), lifting the island to
# I*R, which then acts as the drain bias of the left STL (2nd latch).
# TRANSIENT drain ramp at 0.7 V/ms: 0 -> 6 -> 0 V, .str snapshots for EBD at
# see solve list below.
# Unstable branches are crossed by real time dynamics -> latch jumps + hysteresis appear directly.
# An S-shaped (snapback) I-V is single-valued in current, so every latch
# shows up as a negative-slope (NDR) segment of V_D(I_D). Count NDR segments.
# VG = -0.2 V.
# Base structure (unchanged otherwise):
# n+ island (30 nm, 1e20, full Tsi) at mid-channel under the same gate
# TOP-CONTACTED island (device-level version of two STLs in series with a tapped middle node):
# the gate is split into two halves (electrically tied, same name) with a 30 nm gap over the island,
# and an OHMIC tap contact sits directly on the island top surface. An ohmic contact is a perfect
# minority-carrier sink, so holes injected into the island recombine there instead of reaching the
# left body (removes the lateral PNP coupling). Tap -> series R (1e4 Ohm) -> ground. No BOX neck.
# Left body = 3e17, right body = 7e17 (two separate floating bodies)
# Left body: source = S.   Right body: source = island.
# -> two parasitic BJTs / two feedback loops in series.
# CPU = 1
# ============================================================

go atlas simflags="-P 1"

set Lg = 0.3
set Lsd = 0.5
set tox = 0.02
set tbox = 0.2
set tgate = 0.1
set te = 1e-7
set tp = 1e-7
set LT = 300
set Xsplit = $Lsd+$Lg*0.50
set W = 0.5
set tsi = 0.05
set Wisl = 0.03
set XiL = $Xsplit-$Wisl/2
set XiR = $Xsplit+$Wisl/2
set Ybot = $tsi+$tbox

#### mesh define ####
mesh space.mult = 1.0 width = $W

x.mesh loc=0.00 spac=0.1
x.mesh loc=$Lsd spac=0.005
x.mesh loc=$XiL spac=0.003
x.mesh loc=$XiR spac=0.003
x.mesh loc=$Lsd+$Lg spac=0.005
x.mesh loc=$Lsd+$Lg+$Lsd spac=0.1

y.mesh loc=-$tox-$tgate spac=0.05
y.mesh loc=-$tox spac=0.005
y.mesh loc=0.00 spac=0.005
y.mesh loc=$tsi/2 spac=0.01
y.mesh loc=$tsi spac=0.005
y.mesh loc=$tsi+0.05 spac=0.02
y.mesh loc=$Ybot-0.03 spac=0.01
y.mesh loc=$Ybot spac=0.005

#### regions ####
region num=1 x.min=$Lsd x.max=$XiL y.max=-$tox poly
region num=11 x.min=$XiR x.max=$Lsd+$Lg y.max=-$tox poly
# oxide filling the gate gap above the island
region num=12 x.min=$XiL x.max=$XiR y.max=-$tox oxide
region num=2 x.min=$Lsd x.max=$Lsd+$Lg y.max=0 y.min=-$tox oxide
region num=3 y.min=0 y.max=$tsi silicon
region num=4 x.min=0 x.max=$Lsd y.min=0 y.max=$tsi silicon
region num=5 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.min=0 y.max=$tsi silicon
region num=6 y.min=$tsi y.max=$tsi+$tbox oxide
region num=7 x.min=0 x.max=$Lsd y.max=0 material=vacuum
region num=8 x.min=$Lsd+$Lg x.max=$Lsd+$Lg+$Lsd y.max=0 material=vacuum
# n+ island as a separate silicon region (for region-specific lifetime)
region num=10 x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi silicon

#### electrodes ####
electrode name=gate x.min=$Lsd x.max=$XiL y.min=-$tox y.max=-$tox
electrode name=gate x.min=$XiR x.max=$Lsd+$Lg y.min=-$tox y.max=-$tox
electrode name=source x.max=$Lsd y.min=0 y.max=0
electrode name=drain x.min=$Lsd+$Lg y.min=0 y.max=0
# ohmic tap contact on top of the island
electrode name=tap x.min=$XiL+0.005 x.max=$XiR-0.005 y.min=0 y.max=0
electrode substrate

#### doping ####
doping uniform conc=3.0e17 p.type x.min=$Lsd x.max=$XiL y.min=0 y.max=$tsi
doping uniform conc=7.0e17 p.type x.min=$XiR x.max=$Lsd+$Lg y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type x.min=$XiL x.max=$XiR y.min=0 y.max=$tsi
doping uniform conc=1e20 n.type reg=4
doping uniform conc=1e20 n.type reg=5
doping uniform conc=1e21 n.type reg=1
doping uniform conc=1e21 n.type reg=11

save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_INIT.str

#### contacts ####
contact name=drain
contact name=source
contact name=substrate
# island tap to ground through a series resistor
contact name=tap resistance=5000

#### probes ####
probe name=VB_left  potential x=0.5675 y=0.035
probe name=VB_right potential x=0.7325 y=0.035
probe name=V_island potential x=0.65 y=0.025
probe name=PH_left  P.CONC x=0.5675 y=0.035
probe name=PH_right P.CONC x=0.7325 y=0.035
probe name=QH_left  integrated LEFT=$Lsd RIGHT=$XiL BOTTOM=0 TOP=$tsi P.CONC
probe name=QH_right integrated LEFT=$XiR RIGHT=$Lsd+$Lg BOTTOM=0 TOP=$tsi P.CONC

#### physical models ####
material material=silicon taun0=$te taup0=$tp

models print bgn hcte consrh conmob fldmob fermi trap.tunnel bbt.std temp=$LT
impact selb length.rel

output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps

#### numerical method ####
method block newton climit=100 itlimit=200 NBLOCKIT=200 trap maxtraps=10

#### gate bias ####
solve vfinal=-0.2 vstep=-0.05 name=gate
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_VG.str

#### transient drain ramp, 0.7 V/ms, 0 -> 6 -> 0 V, .str saved along the way ####
log outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2.log j.electron j.hole
solve vdrain=1.5 ramptime=2.142857e-03 tstop=2.142857e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_1p5.str
solve vdrain=2.0 ramptime=7.142857e-04 tstop=2.857143e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_2p0.str
solve vdrain=2.5 ramptime=7.142857e-04 tstop=3.571429e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_2p5.str
solve vdrain=2.8 ramptime=4.285714e-04 tstop=4.000000e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_2p8.str
solve vdrain=2.9 ramptime=1.428571e-04 tstop=4.142857e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_2p9.str
solve vdrain=3.0 ramptime=1.428571e-04 tstop=4.285714e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_3p0.str
solve vdrain=3.1 ramptime=1.428571e-04 tstop=4.428571e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_3p1.str
solve vdrain=3.5 ramptime=5.714286e-04 tstop=5.000000e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_3p5.str
solve vdrain=4.0 ramptime=7.142857e-04 tstop=5.714286e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_4p0.str
solve vdrain=5.0 ramptime=1.428571e-03 tstop=7.142857e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_5p0.str
solve vdrain=6.0 ramptime=1.428571e-03 tstop=8.571429e-03 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_UP_6p0.str
solve vdrain=5.0 ramptime=1.428571e-03 tstop=1.000000e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_5p0.str
solve vdrain=4.0 ramptime=1.428571e-03 tstop=1.142857e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_4p0.str
solve vdrain=3.5 ramptime=7.142857e-04 tstop=1.214286e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_3p5.str
solve vdrain=3.0 ramptime=7.142857e-04 tstop=1.285714e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_3p0.str
solve vdrain=2.8 ramptime=2.857143e-04 tstop=1.314286e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_2p8.str
solve vdrain=2.6 ramptime=2.857143e-04 tstop=1.342857e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_2p6.str
solve vdrain=2.4 ramptime=2.857143e-04 tstop=1.371429e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_2p4.str
solve vdrain=2.2 ramptime=2.857143e-04 tstop=1.400000e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_2p2.str
solve vdrain=2.0 ramptime=2.857143e-04 tstop=1.428571e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_2p0.str
solve vdrain=1.5 ramptime=7.142857e-04 tstop=1.500000e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_1p5.str
solve vdrain=1.0 ramptime=7.142857e-04 tstop=1.571429e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_1p0.str
solve vdrain=0.0 ramptime=1.428571e-03 tstop=1.714286e-02 tstep=1e-9
save outf=TAPT_ISL_W30TC_L3_R7_R1e4_UD6S_VGm0p2_DN_0p0.str
log off
quit
