# CTRL_CUT_OSC_R_1n : control experiment, generated by 1029_ctrl/make_ctrl.py
# CUT: SINK_TE8_XS60 cut in half through the centre of the metal core (same geometry/doping/mesh per half). Constant 1e-09 A into the drain node, C = 1e-12 F. Run CTRL_CUT_IDVD first (it writes the _VG.str files).
# Reference: 1028_osc/OSC_R_1n
# Two separate ATLAS devices (Aright, Aleft) in MixedMode: Vd node 1 -> right STL -> node 3 (Rtap 1e7 -> GND) -> left STL -> GND.
# Gates tied (node 2, -0.2 V). Same models, tau0_Si 1e-8 s, width 0.5 um.
#### ---------- MixedMode: two separate devices in series ----------
go atlas simflags="-P 1"
.begin
Idrain 1 0 pwl 0, 0, 1e-6, -1e-09
Cdrain 1 0 1e-12
Vgate  2 0 -0.2
Rtap   3 0 1e7
Aright 1=drain 3=source 2=gate 0=substrate width=0.5 infile=CTRL_CUT_R_VG.str
Aleft  3=drain 0=source 2=gate 0=substrate width=0.5 infile=CTRL_CUT_L_VG.str
.nodeset v(1)=0 v(2)=-0.2 v(3)=0
.numeric lte=0.3 toltr=1e-5
.options print relpot
.log outfile=CTRL_CUT_OSC_R_1n.log
.tran 1e-9 0.005
.save master=CTRL_CUT_OSC_R_1n_T tsave=1e-3 2e-3 3e-3 4e-3 5e-3
.end

# same models as the reference deck, given once per device
material device=Aright material=silicon taun0=1e-8 taup0=1e-8
models device=Aright print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=300
impact device=Aright selb length.rel
material device=Aleft material=silicon taun0=1e-8 taup0=1e-8
models device=Aleft print bgn consrh conmob fldmob fermi trap.tunnel bbt.std temp=300
impact device=Aleft selb length.rel
output band.param con.band val.band recomb u.srh u.bbt qtunn.bbt impact e.field traps
method newton climit=100 itlimit=200 trap maxtraps=10

go atlas simflags="-P 1"
quit
