# model_latch.py
m(V) = 0.8628 / (1 + exp(-(V - 2.697) / 0.5152))   (V = island potential)
g(I) = 0.03184 (I/1uA)^-0.2813 + 0.01636 (I/1uA)^0.5004 / (1 + (I/0.0004814)^0.5004)
G0 = 1e-15 A, R_tap = 1e+07 Ohm
eta_II(W) = 0.02914 exp(-W / 21.3 nm)   (state-II snapshots, width sweep)
